# ─────────────────────────────────────────────────────────────
# PLANTILLA de configuración. Es seguro subir ESTE archivo a GitHub
# porque no tiene claves reales.
#
# Para usar en tu compu:  copiá este archivo como ".env" y completalo.
# El ".env" real NUNCA se sube (ya está en .gitignore).
# Al publicar (Render, etc.): cargá estos valores en el panel del
# hosting, en "Environment Variables". No los pongas en el código.
# ─────────────────────────────────────────────────────────────

# Código de acceso (recomendado si la app va a estar publicada).
# Si lo completás, la app pide este código antes de usarse, así nadie
# más gasta tu voz. Dejalo vacío para no pedir nada (uso local).
ACCESS_CODE=

# Voz: sin las dos variables de abajo usa la voz gratis de Microsoft Edge
# (sin clave, pero no oficial y con límite por IP).
# Si las completás usa Azure Speech (API oficial, más estable):
# el plan gratis "F0" incluye 500.000 caracteres por mes.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Puerto del backend (opcional; el hosting suele asignarlo solo)
# PORT=3001
